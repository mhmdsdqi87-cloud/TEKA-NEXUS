<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- v1.0.2: WebView shell — INTERNET permission only. The TWA-era
         <queries> browser-visibility block is gone: we no longer look up any
         external browser, which is what eliminated the Force Close class of
         failures on devices without Chrome (Myket test devices). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TwaSplash">

        <!-- The single launcher activity: a native WebView shell.
             Theme.TwaSplash paints the brand background from the very first
             frame — no white flash, no external browser involved. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links open the exact URL inside the app's WebView. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="teka-nexus.vercel.app" />
            </intent-filter>
        </activity>
    </application>
</manifest>
