# TEKA NEXUS — environment variables (copy to .env and fill in)
# NEVER commit your real .env to Git.

# ─── ACTIVE SETUP: Supabase Postgres (project ljevcviygnknjmhzvtjk) ──
# The app now runs on Supabase. Region: ap-southeast-1 (Singapore),
# reached through the IPv4-safe Supavisor session pooler.
# NOTE: the password below is URL-encoded (@ → %40).

DATABASE_URL=postgresql://postgres.ljevcviygnknjmhzvtjk:<PASSWORD-URL-ENCODED>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://ljevcviygnknjmhzvtjk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only
SUPABASE_JWKS_URL=https://ljevcviygnknjmhzvtjk.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=ljevcviygnknjmhzvtjk
SUPABASE_DB_PASSWORD=<raw password, unencoded>
SUPABASE_AVATAR_BUCKET=teka-avatars

# ─── Ops secrets (OPTIONAL — auto-derived from DATABASE_URL when unset) ──
# /api/bootstrap DDL-bootstrap key. If unset, a key derived from DATABASE_URL
# is used (nothing secret ships in source). Set explicitly to control rotation.
# BOOTSTRAP_KEY=
# HMAC secret for OS speedrun timer tokens (same auto-derive behavior).
# SPEEDRUN_HMAC_SECRET=

# ─── AI provider (Academy tutor · NEXUS AI · project assistant · TTS) ──
# Optional: any OpenAI-compatible chat endpoint for production hosting.
# Leave empty in local dev — the sandbox SDK fallback covers it.
# AI_BASE_URL=https://your-openai-compatible-endpoint/v4
# AI_API_KEY=
# AI_MODEL=free-chat-model
# Optional voice tuning for POST /api/tts (OpenAI-compatible /audio/speech):
# AI_TTS_MODEL=tts-1
# AI_TTS_VOICE=alloy

# ─── Google OAuth (REMOVED in v1.70.0) ───────────────────────────
# Google login was removed end to end — password auth is the only sign-in
# path. If these legacy vars are still set in a deployment they are inert.
# Optional: pin the public origin used for redirects behind proxies (Vercel sets
# its own headers; only set this if the computed origin is wrong).
# NEXT_PUBLIC_APP_URL=https://teka-nexus.vercel.app

# Local sandbox dev: `bun run db:generate` auto-builds prisma/schema.local.prisma (SQLite mirror) + regenerates the client. Canonical schema.prisma stays PostgreSQL — never switch it.
