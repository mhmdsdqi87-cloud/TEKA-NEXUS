# Normalize line endings in the repo; checkouts may localize.
* text=auto eol=lf

# Source files — always LF.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.prisma text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows-only scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — never diff or normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.apk binary
*.db binary
*.sqlite binary

# Linguist — keep the language bar honest.
docs/* linguist-documentation
*.md linguist-documentation
public/screenshots/* linguist-documentation
