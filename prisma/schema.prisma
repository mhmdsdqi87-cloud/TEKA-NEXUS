// TEKA NEXUS — Database Schema
// Adapted from the master spec (§21) for Prisma + SQLite.
// SQLite notes: no native enums or arrays → status enums are plain Strings
// validated in application code (see src/lib/constants.ts), and multi-value
// fields are stored as JSON strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// IDENTITY & AUTH
// ─────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  username            String    @unique // normalized lowercase, 3-24 chars
  passwordHash        String
  displayName         String
  bio                 String    @default("")
  avatarColor         String    @default("cyan") // brand gradient key: cyan|violet|ember|lime|rose|gold
  avatarUrl           String?   // optional external avatar
  websiteUrl          String    @default("")
  role                String    @default("user") // user | moderator | admin
  goals               String    @default("[]") // JSON: build|contribute|learn|discover
  interests           String    @default("[]") // JSON: category slugs
  xp                  Int       @default(0)
  reputation          Int       @default(0)
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions             Session[]
  userSkills           UserSkill[]
  ownedProjects        Project[]           @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  collaborationRequests CollaborationRequest[]
  projectUpdates       ProjectUpdate[]
  tasksCreated         Task[]              @relation("TaskCreator")
  tasksAssigned        Task[]              @relation("TaskAssignee")
  taskComments         TaskComment[]
  milestonesCreated    Milestone[]
  followers            Follow[]            @relation("FollowFollowing")
  following            Follow[]            @relation("FollowFollower")
  projectLikes         ProjectLike[]
  projectSaves         ProjectSave[]
  projectComments      ProjectComment[]
  notificationsSent    Notification[]      @relation("NotificationActor")
  notifications        Notification[]      @relation("NotificationRecipient")
  reportsFiled         Report[]
  activities           ProjectActivity[]
  contributionEvents   ContributionEvent[]
  blocksIssued         UserBlock[]         @relation("Blocker")
  blocksReceived       UserBlock[]         @relation("Blocked")
  notificationPrefs    UserNotificationPrefs?
  academyProgress      AcademyProgress[]
  academyCertificates  AcademyCertificate[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // 48-byte random hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// SKILLS TAXONOMY
// ─────────────────────────────────────────────────────────────

model Skill {
  id   String @id @default(cuid())
  slug String @unique
  name String

  users          UserSkill[]
  projectNeeds   ProjectRequiredSkill[]
}

model UserSkill {
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

// ─────────────────────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────────────────────

model Project {
  id            String    @id @default(cuid())
  slug          String    @unique // kebab-case, unique
  name          String
  tagline       String
  description   String    @default("")
  category      String // e.g. WEB_DEVELOPMENT (see constants)
  status        String    @default("IDEA") // IDEA|PLANNING|IN_DEVELOPMENT|BETA|RELEASED|PAUSED|ARCHIVED
  visibility    String    @default("PUBLIC") // PUBLIC|PRIVATE|UNLISTED
  coverImage    String    @default("") // path under /covers or external
  repositoryUrl String    @default("")
  demoUrl       String    @default("")
  websiteUrl    String    @default("")
  ownerId       String
  owner         User      @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  archivedAt    DateTime?

  members            ProjectMember[]
  tags               ProjectTag[]
  requiredSkills     ProjectRequiredSkill[]
  requests           CollaborationRequest[]
  updates            ProjectUpdate[]
  tasks              Task[]
  milestones         Milestone[]
  likes              ProjectLike[]
  saves              ProjectSave[]
  comments           ProjectComment[]
  activities         ProjectActivity[]
  contributionEvents ContributionEvent[]

  @@index([category, status, visibility])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([ownerId])
}

model ProjectTag {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       String

  @@unique([projectId, tag])
  @@index([tag])
}

model ProjectRequiredSkill {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("CONTRIBUTOR") // OWNER|ADMIN|CONTRIBUTOR|VIEWER
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model CollaborationRequest {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  requestedRole String    @default("CONTRIBUTOR")
  introduction  String
  portfolioUrl  String    @default("")
  status        String    @default("PENDING") // PENDING|ACCEPTED|REJECTED|WITHDRAWN
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, applicantId]) // no duplicate active requests
  @@index([applicantId])
}

// ─────────────────────────────────────────────────────────────
// WORKSPACE: UPDATES / TASKS / MILESTONES
// ─────────────────────────────────────────────────────────────

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  status      String    @default("BACKLOG") // BACKLOG|TODO|IN_PROGRESS|IN_REVIEW|DONE
  priority    String    @default("NORMAL") // LOW|NORMAL|HIGH|URGENT
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String
  creator     User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  dueAt       DateTime?
  position    Float     @default(1000)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments TaskComment[]

  @@index([projectId, status])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  dueAt       DateTime?
  completedAt DateTime?
  createdById String
  creator     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// SOCIAL GRAPH
// ─────────────────────────────────────────────────────────────

model Follow {
  followerId  String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

model ProjectLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, projectId])
  @@index([projectId])
}

model ProjectSave {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, projectId])
  @@index([projectId])
}

model ProjectComment {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS / MODERATION / ACTIVITY / REPUTATION
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        String // NEW_FOLLOWER|PROJECT_COMMENT|COLLAB_REQUEST|REQUEST_ACCEPTED|REQUEST_REJECTED|TASK_ASSIGNED|MEMBER_JOINED|SYSTEM
  entityType  String?   // project|user|task|request
  entityId    String?
  payload     String    @default("{}") // JSON safe payload (display strings only)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model UserNotificationPrefs {
  userId                 String  @id
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectActivity        Boolean @default(true)
  collaborationRequests  Boolean @default(true)
  socialActivity         Boolean @default(true)
  updatedAt              DateTime @updatedAt
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // project|user|comment
  targetId   String
  reason     String // SPAM|HARASSMENT|INAPPROPRIATE|COPYRIGHT|OTHER
  details    String   @default("")
  status     String   @default("OPEN") // OPEN|REVIEWED|RESOLVED
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  eventType String // PROJECT_CREATED|UPDATE_POSTED|MILESTONE_COMPLETED|RELEASE_PUBLISHED|MEMBER_JOINED|TASK_COMPLETED
  metadata  String   @default("{}") // JSON safe metadata
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt])
}

model ContributionEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  eventType  String // TASK_COMPLETED|UPDATE_POSTED|MILESTONE_COMPLETED|RELEASE_PUBLISHED|COLLABORATION_ACCEPTED|PROJECT_CREATED
  sourceType String // task|milestone|update|project|request
  sourceId   String
  xp         Int      @default(0)
  reputation Int      @default(0)
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, eventType, sourceType, sourceId]) // idempotent awards
  @@index([userId])
}

model UserBlock {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ─────────────────────────────────────────────────────────────
// ACADEMY (TEKA Academy — free Python & HTML courses)
// ─────────────────────────────────────────────────────────────

model AcademyProgress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String   // "python-basics" | "html-basics"
  completedLessons String   @default("[]") // JSON array of lessonIds
  lastLessonId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model AcademyCertificate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  code      String   @unique // human-readable certificate code, e.g. TEKA-PY-8F2KQA
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}
